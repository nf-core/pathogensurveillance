{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/pathogensurveillance/main/assets/schema_input.json",
    "title": "nf-core/pathogensurveillance pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample_id": {
                "type": ["string", "integer"]
            },
            "name": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "path": {
                "type": "string"
            },
            "path_2": {
                "type": "string",
                "pattern": "^[^\\s]+\\.f(ast)?q\\.gz(;[^\\s]+\\.f(ast)?q\\.gz)*$",
                "errorMessage": "FastQ file(s) for reads 2 cannot contain spaces, must have extension '.fq.gz' or '.fastq.gz', and multiple files must be separated by semicolons."
            },
            "ncbi_accession": {
                "type": "string",
                "pattern": "^(?:[A-Z]{3,6}[0-9]+|GC[AF]_[0-9]+(?:\\.[0-9]+)?)$",
                "errorMessage": "The `ncbi_accession` column contains a value that does not look like an SRA or NCBI Assembly accession."
            },
            "ncbi_query": {
                "type": "string"
            },
            "query_db": {
                "type": "string",
                "enum": ["SRA", "assembly", "sra"],
                "errorMessage": "The `query_db` column must be either 'SRA' or 'assembly'."
            },
            "ncbi_query_max": {
                "type": "integer",
                "default": 10,
                "minimum": 1,
                "errorMessage": "The `ncbi_query_max` column must be an integer greater than 0."
            },
            "sequence_type": {
                "type": "string",
                "pattern": "(?i)illumina|nanopore|pacbio|bgiseq|assembly",
                "errorMessage": "The `sequence_type` column must be one of 'illumina', 'nanopore', 'pacbio', 'bgiseq', or 'assembly'."
            },
            "report_group_ids": {
                "type": ["string", "integer"],
                "default": "_no_group_defined_",
                "pattern": "^[a-zA-Z0-9_ -]+(?:;[a-zA-Z0-9_ -]+)*$"
            },
            "color_by": {
                "type": "string"
            },
            "ploidy": {
                "type": "integer",
                "default": 1,
                "minimum": 1,
                "errorMessage": "The `ploidy` column must be an integer greater than or equal to 1."
            },
            "enabled": {
                "type": "boolean",
                "default": true
            },
            "ref_group_ids": {
                "type": ["string", "integer"]
            }
        },
        "allOf": [
        {
            "if": {
                "required": ["sequence_type"],
                "properties": {
                    "sequence_type": {
                        "pattern": "(?i)^assembly$"
                    }
                }
            },
            "then": {
                "properties": {
                    "path": {
                        "pattern": "^[^\\s]+\\.(fasta|fa|fna)(\\.gz)?$",
                        "errorMessage": "Assembly input must be a single FASTA file with extension '.fa', '.fasta', or '.fna', optionally followed by '.gz'."
                    }
                }
            },
            "else": {
                "properties": {
                    "path": {
                        "pattern": "^[^\\s]+\\.f(ast)?q\\.gz(;[^\\s]+\\.f(ast)?q\\.gz)*$",
                        "errorMessage": "FastQ file(s) for reads 1 must be provided, cannot contain spaces, must have extension '.fq.gz' or '.fastq.gz', and multiple files must be separated by semicolons."
                    }
                }
            }
        },
        {
            "if": {
                "required": ["ncbi_query"]
            },
            "then": {
                "required": ["query_db"]
            }
        }
        ]
    }
}
