nextflow_pipeline {

    name "Test pipeline with test profile"
    script "../main.nf"
    tag "full_pipeline"
    tag "dev"

    test("test profile") {
        when {
            params {
                outdir = "$outputDir"
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/pathogensurveillance/samplesheets/test.csv"

                phylo_max_genes = 20
                n_ref_closest = 1
                n_ref_closest_named = 1
                n_ref_context = a7
                n_ref_strains = '1'
                n_ref_species = '3'
                n_ref_genera = '3'
                skip_core_phylogeny = false
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, sort: true, ignore: ['pipeline_info/*.{html,json,txt}', 'shared_genes/core/*'])

            assertAll(
		        { assert workflow.success },
                { assert snapshot(
                    // All stable path name, with a relative path
                    stable_name,

                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/version_info.yml")
                ).match() }
            )
        }
    }
}
