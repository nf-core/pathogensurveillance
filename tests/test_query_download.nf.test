nextflow_pipeline {

    name "Test pipeline with sample input queries"
    script "../main.nf"
    tag "pipeline"
    tag "input_test_full"

    test("ncbi query test") {

        when {
            params {
                outdir = "$outputDir"
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/pathogensurveillance/samplesheets/test_query_download.csv"

                max_samples = 2
                phylo_max_genes = 20
                n_ref_closest = 1
                n_ref_closest_named = 1
                n_ref_context = 3
                n_ref_strains = '1'
                n_ref_species = '3'
                n_ref_genera = '3'
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            // Test snapshots with NCBI queries are non-deterministic amd require further filtering
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, sort: true, ignore: ['pipeline_info/*.{html,json,txt}', 'shared_genes/core/*']).grep { !(it =~ /(?:[A-Z]{3}\d+|GC[AF][_\d.]*|reference_data\/considered\/\d+\.(?:json|tsv))/) }

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // All stable path name, with a relative path
                    stable_name,

                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/version_info.yml")
                ).match() }
            )
        }
    }

    //todo: modify nf-core modules stubs to allow pipeline-level stub tests
    /* test("ncbi query test, stub") {
        options "-stub"
        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
        }
    } */
}
