nextflow_pipeline {

    name "Test pipeline with small genomes profile"
    script "../main.nf"
    tag "full_pipeline"
    tag "genomic"

    test("small genomes profile") {

        when {
            params {
                outdir = "$outputDir"
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/pathogensurveillance/samplesheets/small_genomes.csv"

                max_samples = 3
                phylo_max_genes = 100
                n_ref_closest = 1
                n_ref_closest_named = 1
                n_ref_context = 7
                n_ref_strains = '1'
                n_ref_species = '5'
                n_ref_genera = '5'
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, sort: true, ignore: ['pipeline_info/*.{html,json,txt}', 'shared_genes/**/*', 'gene_lists/*', 'trees/**/*'])
            def report_html = new File("${params.outdir}/reports/all_pathsurveil_report.html").text
            def core_tree = new File("${params.outdir}/trees/multigene/all--core--cluster_1.treefile").text
            def busco_tree = new File("${params.outdir}/trees/multigene/all--busco--cluster_1.treefile").text

            assertAll(
                { assert workflow.success},
                { assert core_tree.contains('GCF_013394085_1') },
                { assert !core_tree.contains('GCF_000002765_6') },
                { assert busco_tree.contains('GCF_000002765_6') },
                { assert !busco_tree.contains('GCF_013394085_1') },
                { assert report_html.contains('This is a multigene phylogeny of samples') },
                { assert report_html.contains('This is a representation of a Single Nucleotide Polymorphism (SNP) tree') },
                { assert !report_html.contains('Could not generate multigene phylogeny.') },
                { assert !report_html.contains('There is no tree to draw.') },
                { assert snapshot(
                    // All stable path name, with a relative path
                    stable_name,

                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/version_info.yml")
                ).match() }
            )
        }
    }
}
