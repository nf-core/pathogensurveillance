nextflow_pipeline {

    name "Test pipeline with test profile"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_test"

    test("test profile") {
        when {
            params {
                outdir = "$outputDir"
                max_samples = 1
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, sort: true, ignore: ['pipeline_info/*.{html,json,txt}', 'shared_genes/core/*'])

            assertAll(
		        { assert workflow.success },
                { assert snapshot(
                    // All stable path name, with a relative path
                    stable_name,

                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/version_info.yml")
                ).match() }
            )
        }
    }

    //todo: modify nf-core modules stubs to allow pipeline-level stub tests
    /* test("test profile, stub") {
        options "-stub"
        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
        }
    } */
}
