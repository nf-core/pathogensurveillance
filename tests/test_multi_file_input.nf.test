nextflow_pipeline {

    name "Test pipeline with multiple files per sample"
    script "../main.nf"
    tag "input"

    test("multiple files per sample") {

        when {
            params {
                outdir = "$outputDir"
                input = "${baseDir}/tests/test_multi_file_input.csv"
                reference_data = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/pathogensurveillance/samplesheets/test_refs.csv"

                max_samples = 1
                phylo_max_genes = 20
                n_ref_closest = 1
                n_ref_closest_named = 1
                n_ref_context = 3
                n_ref_strains = '1'
                n_ref_species = '3'
                n_ref_genera = '3'
                skip_core_phylogeny = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }
}
