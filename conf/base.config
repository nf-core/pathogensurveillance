/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/pathogensurveillance Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { "${Math.max(1, Math.round(6 * params.ram_scale * task.attempt) as Integer)}.GB" }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    withLabel:process_single {
        cpus   = { 1 }
        memory = { "${Math.max(1, Math.round(6 * params.ram_scale * task.attempt) as Integer)}.GB" }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { Math.max(1, Math.round(2 * params.cpu_scale * task.attempt) as Integer) }
        memory = { "${Math.max(1, Math.round(12 * params.ram_scale * task.attempt) as Integer)}.GB" }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { Math.max(1, Math.round(6 * params.cpu_scale * task.attempt) as Integer) }
        memory = { "${Math.max(1, Math.round(36 * params.ram_scale * task.attempt) as Integer)}.GB" }
        time   = { 8.h  * task.attempt }
    }
    withLabel:process_high {
        cpus   = { Math.max(1, Math.round(12 * params.cpu_scale * task.attempt) as Integer) }
        memory = { "${Math.max(1, Math.round(72 * params.ram_scale * task.attempt) as Integer)}.GB" }
        time   = { 16.h * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { "${Math.max(1, Math.round(200 * params.ram_scale * task.attempt) as Integer)}.GB" }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace_report.tsv"
    overwrite = true
    fields    = "task_id,hash,native_id,process,tag,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,workdir,scratch,error_action"
}
