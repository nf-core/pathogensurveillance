/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/



/*
 * Helper function to calculate scaled CPU allocation for processes
 * Based on base CPU count, retry attempt, cpu_scale, and max_cpus
 */
def scaledCpu(
    Integer baseCpus,
    Integer attempt,
    Float cpuScale = params.cpu_scale,
    Integer maxCpus = params.max_cpus
) {
    def calculatedCpus = baseCpus * cpuScale * attempt
    def result = Math.max(1, Math.round(calculatedCpus) as Integer)
    return maxCpus > 0 ? Math.min(maxCpus, result) : result
}

/*
 * Helper function to calculate scaled RAM allocation for processes
 * Based on base RAM in GB, retry attempt, ram_scale, and max_ram
 */
def scaledRam(
    Number baseRam,
    Integer attempt,
    Number exponent = null,
    Float ramScale = params.ram_scale,
    Integer maxRam = params.max_ram
) {
    def calculatedRam = baseRam * ramScale * (exponent == null ? attempt : Math.pow(exponent, attempt - 1))
    def result = Math.max(1, Math.round(calculatedRam) as Integer)
    if (maxRam > 0) {
        result = Math.min(maxRam, result)
    }
    return "${result}.GB"
}


process {

    // Default settings for all modules
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    errorStrategy = { task.attempt > 1 ? 'finish' : 'retry' }
    maxRetries = 1

    // Module-specific settings
    withName: ASSIGN_BUSCO_REFERENCES {
        publishDir = [
            path: { "${params.outdir}/reference_data/selected" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                } else if (filename.endsWith('_context_refs.tsv')) {
                    return filename.replaceFirst(/_context_refs.tsv$/, '_busco_references.tsv')
                } else {
                    return filename
                }
            }
        ]
        cpus   = { 1                   }
        memory = { scaledRam(4, task.attempt) }
        time   = { 4.h * task.attempt  }
    }

    withName: ASSIGN_CORE_REFERENCES {
        publishDir = [
            path: { "${params.outdir}/reference_data/selected" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                } else if (filename.endsWith('_context_refs.tsv')) {
                    return filename.replaceFirst(/_context_refs.tsv$/, '_core_references.tsv')
                } else {
                    return filename
                }
            }
        ]
        cpus   = { 1                   }
        memory = { scaledRam(4, task.attempt) }
        time   = { 4.h * task.attempt  }
    }

    withName: ASSIGN_MAPPING_REFERENCE {
        publishDir = [
            path: { "${params.outdir}/reference_data/selected" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus   = { 1                   }
        memory = { scaledRam(4, task.attempt) }
        time   = { 4.h * task.attempt }
    }

    withName: BAKTA_BAKTA {
        publishDir = [
            path: { "${params.outdir}/annotations/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus   = { scaledCpu(4, task.attempt) }
        memory = { scaledRam(7, task.attempt) }
        time   = { 24.h * task.attempt }
        ext.args = '--force --skip-plot --skip-crispr'
        maxRetries = 3
    }

    withName: BAKTA_BAKTADBDOWNLOAD {
        publishDir = [
            path: { "${params.outdir}/downloads/databases/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.data_dir == "false"
        ]
        ext.args = { "--type ${params.bakta_db_type}" }
        storeDir = { params.data_dir == "false" ? null : "${params.data_dir}/bakta_db" }
        beforeScript = { task.attempt == 1 ? null : "sleep ${Math.pow(5, task.attempt)}" }
    }

    withName: BBMAP_SENDSKETCH {
        publishDir = [
            path: { "${params.outdir}/sendsketch" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = 'tossbrokenreads=t printall=t reads=10m samplerate=0.5 minkeycount=2'
        cpus   = { 1                   }
        memory = { scaledRam(3, task.attempt) }
        time   = { 1.h  * task.attempt }
        maxRetries = 10

        // Settings to avoid API rate limits and not put too much stress on servers
        maxForks = params.max_parallel_downloads ?: 3
        errorStrategy = { task.attempt >= 3 ? 'finish' : 'retry' }
        beforeScript = { task.attempt == 1 ? 'sleep "0.$(($RANDOM % 100))"' : "sleep ${Math.pow(5, task.attempt)}" }
    }

    withName: BUSCO_BUSCO {
        publishDir = [
            path: { "${params.outdir}/busco" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { "${meta.id}--${lineage}" }
        ext.args = '--mode genome --metaeuk'
        cpus   = { scaledCpu(6, task.attempt) }
        memory = { scaledRam(4, task.attempt) }
        time   = { 120.h * task.attempt }
    }

    withName: BUSCO_DOWNLOAD {
        publishDir = [
            path: { "${params.outdir}/downloads/databases/busco" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.data_dir == "false"
        ]
        storeDir = { params.data_dir == "false" ? null : "${params.data_dir}/busco_db" }
        beforeScript = { task.attempt == 1 ? null : "sleep ${Math.pow(5, task.attempt)}" }
    }

    withName: BWA_INDEX {
        // Prevent from using swap and therefore hanging indefintely rather than failing and retrying with more RAM
        containerOptions = { workflow.containerEngine == 'singularity' ? '' : "--memory-swap ${task.memory.mega.intValue()}m" }
        publishDir = [
            path: { "${params.outdir}/reference_data/indexes/bwa" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus   = { 1                   }
        memory = { scaledRam(8, task.attempt) }
        time   = { 24.h * task.attempt }
    }

    withName: BWA_MEM {
        publishDir = [
            path: { "${params.outdir}/aligned_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '-M'
        cpus   = { scaledCpu(8, task.attempt) }
        memory = { scaledRam(15, task.attempt) }
        time   = { 48.h  * task.attempt }
    }

    withName: BWAMEM3_INDEX {
        beforeScript = """
        if ! grep -q 'avx2' /proc/cpuinfo 2>/dev/null; then
            echo "ERROR: This CPU does not support AVX2, which is required by bwa-mem3." >&2
            echo "  Please re-run the pipeline with: --aligner bwa" >&2
            exit 1
        fi
        """

        publishDir = [
            path: { "${params.outdir}/reference_data/indexes/bwa" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus   = { 1                   }
        memory = { scaledRam(8, task.attempt) }
        time   = { 24.h * task.attempt }
    }

    withName: BWAMEM3_MEM {
        beforeScript = """
        if ! grep -q 'avx2' /proc/cpuinfo 2>/dev/null; then
            echo "ERROR: This CPU does not support AVX2, which is required by bwa-mem3." >&2
            echo "  Please re-run the pipeline with: --aligner bwa" >&2
            exit 1
        fi
        """

        publishDir = [
            path: { "${params.outdir}/aligned_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '-M'
        cpus   = { scaledCpu(8, task.attempt) }
        memory = { scaledRam(15, task.attempt) }
        time   = { 48.h  * task.attempt }
